#!/bin/bash
# Waybar custom module — shows current DAMX thermal profile + CPU/GPU temps and fan speeds.
# Requires DAMX daemon running: sudo systemctl start damx-daemon

profile=$(python3 -c "
import socket, json, sys
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(2)
    s.connect('/var/run/DAMX.sock')
    s.send(json.dumps({'command': 'get_all_settings'}).encode())
    raw = s.recv(4096)
    s.close()
    d = json.loads(raw)['data']
    print(d['thermal_profile']['current'])
except:
    sys.exit(1)
" 2>/dev/null) || exit 0

hwmon_path="/sys/class/hwmon/hwmon4"
cpu_temp=$(( $(cat "$hwmon_path/temp1_input" 2>/dev/null || echo 0) / 1000 ))
gpu_temp=$(( $(cat "$hwmon_path/temp2_input" 2>/dev/null || echo 0) / 1000 ))
cpu_fan=$(cat "$hwmon_path/fan1_input" 2>/dev/null || echo 0)
gpu_fan=$(cat "$hwmon_path/fan2_input" 2>/dev/null || echo 0)

case "$profile" in
  "low-power")            icon=""; label="Low Power" ;;
  "quiet")                icon=""; label="Quiet" ;;
  "balanced")             icon=""; label="Balanced" ;;
  "balanced-performance") icon=""; label="Performance" ;;
  "performance")          icon=""; label="Turbo" ;;
  *)                      exit 0 ;;
esac

fan_info="${cpu_fan} / ${gpu_fan} RPM"
[[ "$cpu_fan" == "0" && "$gpu_fan" == "0" ]] && fan_info="stopped"

tooltip="Profile: $label\nCPU: ${cpu_temp}°C  GPU: ${gpu_temp}°C\nFans: $fan_info\nClick to cycle · Right-click for DAMX"
echo "{\"text\": \" $icon\", \"tooltip\": \"$tooltip\", \"class\": \"$profile\"}"
