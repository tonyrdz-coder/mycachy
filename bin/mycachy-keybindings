#!/bin/bash

declare -A KEYCODE_SYM_MAP
declare -A FALLBACK_KEYCODE_SYM_MAP=(
  [10]="1" [11]="2" [12]="3" [13]="4" [14]="5"
  [15]="6" [16]="7" [17]="8" [18]="9" [19]="0"
  [20]="MINUS" [21]="EQUAL" [61]="SLASH"
)
declare -A LUA_BIND_KEY_MAP

build_keymap_cache() {
  local keymap
  keymap="$(xkbcli compile-keymap)" || return 1

  while IFS=, read -r code sym; do
    [[ -z $code || -z $sym ]] && continue
    KEYCODE_SYM_MAP["$code"]="$sym"
  done < <(
    awk '
      BEGIN { sec = "" }
      /xkb_keycodes/ { sec = "codes"; next }
      /xkb_symbols/  { sec = "syms";  next }
      sec == "codes" {
        if (match($0, /<([A-Za-z0-9_]+)>\s*=\s*([0-9]+)\s*;/, m)) code_by_name[m[1]] = m[2]
      }
      sec == "syms" {
        if (match($0, /key\s*<([A-Za-z0-9_]+)>\s*\{\s*\[\s*([^, \]]+)/, m)) sym_by_name[m[1]] = m[2]
      }
      END {
        for (k in code_by_name) {
          c = code_by_name[k]; s = sym_by_name[k]
          if (c != "" && s != "" && s != "NoSymbol") print c "," s
        }
      }
    ' <<<"$keymap"
  )
}

lookup_keycode_cached() {
  local symbol="${KEYCODE_SYM_MAP[$1]}"
  [[ -z $symbol ]] && symbol="${FALLBACK_KEYCODE_SYM_MAP[$1]}"
  [[ -z $symbol ]] && symbol="code:$1"
  printf '%s\n' "${symbol^^}"
}

parse_keycodes() {
  while IFS= read -r line; do
    if [[ $line =~ code:([0-9]+) ]]; then
      local code="${BASH_REMATCH[1]}"
      local symbol
      symbol=$(lookup_keycode_cached "$code")
      echo "${line/code:${code}/$symbol}"
    elif [[ $line =~ mouse:([0-9]+) ]]; then
      local code="${BASH_REMATCH[1]}"
      local symbol
      case "$code" in
        272) symbol="LEFT MOUSE BUTTON" ;;
        273) symbol="RIGHT MOUSE BUTTON" ;;
        274) symbol="MIDDLE MOUSE BUTTON" ;;
        *)   symbol="mouse:${code}" ;;
      esac
      echo "${line/mouse:${code}/$symbol}"
    else
      echo "$line"
    fi
  done
}

build_lua_bind_key_cache() {
  command -v lua >/dev/null 2>&1 || return 0

  while IFS=$'\t' read -r modmask description key; do
    [[ -z $modmask || -z $description || -z $key ]] && continue
    LUA_BIND_KEY_MAP["$modmask,$description"]="$key"
  done < <(
    lua <<'LUA'
local modifiers = { SHIFT = 1, CTRL = 4, CONTROL = 4, ALT = 8, SUPER = 64 }

local function split_keys(keys)
  local modmask = 0
  local key = ""
  for part in string.gmatch(keys, "[^+]+") do
    local value = part:gsub("^%s+", ""):gsub("%s+$", "")
    local modifier = modifiers[string.upper(value)]
    if modifier then
      modmask = modmask + modifier
    else
      key = value
    end
  end
  return modmask, key
end

local function proxy()
  local p = {}
  return setmetatable(p, {
    __index = function() return p end,
    __call  = function() return p end,
  })
end

local p = proxy()

hl = setmetatable({
  dsp = p,
  bind = function(keys, _, opts)
    opts = opts or {}
    if opts.description and opts.description ~= "" then
      local modmask, key = split_keys(keys)
      print(modmask .. "\t" .. opts.description .. "\t" .. key)
    end
    return p
  end,
  unbind    = function() end,
  config    = function() end,
  env       = function() end,
  monitor   = function() end,
  window_rule = function() end,
  gesture   = function() end,
  animation = function() end,
  curve     = function() end,
  exec_cmd  = function() end,
  on        = function() end,
  workspace_rule = function() end,
}, {
  __index = function() return function() return p end end,
})

local config = os.getenv("HOME") .. "/.config/hypr/hyprland.lua"
local file = io.open(config, "r")
if file then
  file:close()
  pcall(dofile, config)
end
LUA
  )
}

modmask_to_text() {
  case "$1" in
    0)  printf '' ;;
    1)  printf 'SHIFT' ;;
    4)  printf 'CTRL' ;;
    5)  printf 'SHIFT CTRL' ;;
    8)  printf 'ALT' ;;
    9)  printf 'SHIFT ALT' ;;
    12) printf 'CTRL ALT' ;;
    64) printf 'SUPER' ;;
    65) printf 'SUPER SHIFT' ;;
    68) printf 'SUPER CTRL' ;;
    72) printf 'SUPER ALT' ;;
    73) printf 'SUPER SHIFT ALT' ;;
    76) printf 'SUPER CTRL ALT' ;;
    *)  printf '%s' "$1" ;;
  esac
}

dynamic_bindings() {
  local modmask key keycode description dispatcher arg modifiers

  hyprctl -j binds |
    jq -r '.[] | [.modmask, (.key // ""), (.keycode // 0), (.description // ""), (.dispatcher // ""), (.arg // "") | tostring] | join("")' |
    while IFS=$'\x1f' read -r modmask key keycode description dispatcher arg; do
      if [[ -z $key && $keycode != "0" ]]; then
        key="code:$keycode"
      fi
      if [[ -z $key && -n $description ]]; then
        key="${LUA_BIND_KEY_MAP["$modmask,$description"]}"
      fi
      [[ -z $description && $dispatcher == "__lua" ]] && continue

      modifiers=$(modmask_to_text "$modmask")
      printf '%s,%s,%s,%s,%s\n' "$modifiers" "$key" "$description" "$dispatcher" "$arg"
    done
}

parse_binding_records() {
  awk -F, '
{
    key_combo = $1 " + " $2
    gsub(/^[ \t]*\+?[ \t]*/, "", key_combo)
    gsub(/[ \t]+$/, "", key_combo)

    action = $3
    dispatcher = $4

    arg = ""
    for (i = 5; i <= NF; i++) {
        arg = arg $i (i < NF ? "," : "")
    }

    if (action == "") {
        for (i = 4; i <= NF; i++) {
            action = action $i (i < NF ? "," : "")
        }
        sub(/,$/, "", action)
        gsub(/(^|,)[[:space:]]*exec[[:space:]]*,?/, "", action)
        gsub(/^[ \t]+|[ \t]+$/, "", action)
        gsub(/[ \t]+/, " ", key_combo)
        gsub(/&/, "\\&amp;",  action)
        gsub(/</, "\\&lt;",   action)
        gsub(/>/, "\\&gt;",   action)
        gsub(/"/, "\\&quot;", action)
    }

    if (action != "") {
        printf "%-35s → %s\t%s\t%s\n", key_combo, action, dispatcher, arg
    }
}'
}

prioritize_entries() {
  awk -F '\t' '
  {
    line = $1; prio = 50
    if (match(line, /Terminal/))         prio = 0
    if (match(line, /Browser/))          prio = 1
    if (match(line, /File manager/))     prio = 2
    if (match(line, /Text editor/))      prio = 3
    if (match(line, /Launch apps/))      prio = 4
    if (match(line, /Keybindings/))      prio = 5
    if (match(line, /Power menu/))       prio = 6
    if (match(line, /Clipboard/))        prio = 7
    if (match(line, /Screenshot/))       prio = 8
    if (match(line, /Screen record/))    prio = 9
    if (match(line, /Color picker/))     prio = 10
    if (match(line, /Bluetooth/))        prio = 11
    if (match(line, /Wifi/))             prio = 12
    if (match(line, /Close window/))     prio = 13
    if (match(line, /Full screen/))      prio = 14
    if (match(line, /Toggle floating/))  prio = 15
    if (match(line, /Toggle split/))     prio = 16
    if (match(line, /Focus/))            prio = 20
    if (match(line, /Move window/))      prio = 21
    if (match(line, /Resize/))           prio = 22
    if (match(line, /Switch to workspace/)) prio = 30
    if (match(line, /Move to workspace/))   prio = 31
    if (match(line, /Volume/))           prio = 40
    if (match(line, /Brightness/))       prio = 41
    if (match(line, /Play|Next|Previous/)) prio = 42
    if (match(line, /XF86/))             prio = 99
    printf "%d\t%s\n", prio, $0
  }' |
  sort -k1,1n -k2,2 |
  cut -f2-
}

output_binding_records() {
  build_keymap_cache
  build_lua_bind_key_cache

  dynamic_bindings |
    sort -u |
    parse_keycodes |
    parse_binding_records |
    prioritize_entries
}

records=$(output_binding_records)
[[ -z $records ]] && { echo "No bindings found" >&2; exit 1; }

monitor_height=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .height')
menu_height=$((monitor_height * 40 / 100))

cut -f1 <<<"$records" |
  walker --dmenu -p 'Keybindings' --width 800 --height "$menu_height" > /dev/null
