#!/bin/bash

NOPASSWD_FILE="/etc/sudoers.d/99-mycachy-nopasswd-${USER}"
TIMER_NAME="mycachy-nopasswd-expire-${USER}"

MINUTES=${1:-15}
if [[ $1 && ! $1 =~ ^[0-9]+$ ]]; then
  echo "Usage: mycachy-sudo-passwordless [MINUTES]" >&2
  exit 1
fi

# Safety: if file exists but timer is gone (e.g. after reboot), clean up
if sudo test -f "$NOPASSWD_FILE" && ! systemctl is-active "${TIMER_NAME}.timer" &>/dev/null; then
  sudo rm "$NOPASSWD_FILE"
fi

if sudo test -f "$NOPASSWD_FILE"; then
  if [[ $1 ]]; then
    sudo systemctl stop "${TIMER_NAME}.timer" 2>/dev/null
    sudo systemd-run --on-active=${MINUTES}m --timer-property=AccuracySec=1s --unit="$TIMER_NAME" \
      rm "$NOPASSWD_FILE"
    echo "Passwordless sudo timer updated — disables in ${MINUTES} minutes."
  else
    sudo rm "$NOPASSWD_FILE"
    sudo systemctl stop "${TIMER_NAME}.timer" 2>/dev/null
    echo "Passwordless sudo DISABLED. Password required again."
  fi
else
  echo ""
  echo "⚠️  WARNING: This allows ANY process running as your user to run"
  echo "    ANY command as root WITHOUT a password for ${MINUTES} minutes."
  echo ""
  echo "    Useful for AI agents (Claude Code) that need sudo access."
  echo "    Auto-disables after ${MINUTES} minutes, or run this again to disable early."
  echo ""

  if gum confirm "Enable passwordless sudo for ${MINUTES} minutes?"; then
    echo "${USER} ALL=(ALL) NOPASSWD: ALL" | sudo tee "$NOPASSWD_FILE" > /dev/null
    sudo chmod 440 "$NOPASSWD_FILE"
    sudo systemd-run --on-active=${MINUTES}m --timer-property=AccuracySec=1s --unit="$TIMER_NAME" \
      rm "$NOPASSWD_FILE"
    echo ""
    echo "Passwordless sudo ENABLED for ${MINUTES} minutes."
  else
    echo "Aborted."
  fi
fi
